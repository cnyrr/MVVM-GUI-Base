<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme. Overrides every token declared in Tokens.xaml.
        Palette: clean neutral, off-white surfaces, slate text, muted blue accent.
        Inspiration: Tailwind neutrals + blue-600 family.
    -->

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="Brush.Surface.Shell"     Color="#F8F9FA" />
    <SolidColorBrush x:Key="Brush.Surface.Sidebar"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Content"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay"   Color="#FFFFFF" />

    <!-- ===== Content (text / icons) ===== -->
    <SolidColorBrush x:Key="Brush.Content.Primary"   Color="#1F2328" />
    <SolidColorBrush x:Key="Brush.Content.Secondary" Color="#656D76" />
    <SolidColorBrush x:Key="Brush.Content.Disabled"  Color="#AFB8C1" />
    <SolidColorBrush x:Key="Brush.Content.OnAccent"  Color="#FFFFFF" />

    <!-- ===== Accent (interactive elements) ===== -->
    <SolidColorBrush x:Key="Brush.Accent.Default"    Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Accent.Hover"      Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed"    Color="#1E40AF" />
    <SolidColorBrush x:Key="Brush.Accent.Disabled"   Color="#93C5FD" />

    <!-- ===== Borders / separators ===== -->
    <SolidColorBrush x:Key="Brush.Border.Subtle"     Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.Border.Default"    Color="#D1D5DB" />
    <SolidColorBrush x:Key="Brush.Border.Strong"     Color="#9CA3AF" />

    <!-- ===== Interaction states ===== -->
    <SolidColorBrush x:Key="Brush.State.Hover"       Color="#F3F4F6" />
    <SolidColorBrush x:Key="Brush.State.Pressed"     Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.State.Selected"    Color="#DBEAFE" />
    <SolidColorBrush x:Key="Brush.State.Focus"       Color="#3B82F6" />

    <!-- ===== Status ===== -->
    <SolidColorBrush x:Key="Brush.Status.Error"      Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.Status.Warning"    Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Status.Success"    Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.Status.Info"       Color="#2563EB" />

    <!-- ===== Toast surfaces ===== -->
    <SolidColorBrush x:Key="Brush.Toast.Background"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Toast.Border"         Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.Toast.Shadow"         Color="#33000000" />

    <!-- ===== Special ===== -->
    <SolidColorBrush x:Key="Brush.Scrim"             Color="#80000000" />

</ResourceDictionary>