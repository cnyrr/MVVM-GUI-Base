<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark theme. Overrides every token declared in Tokens.xaml.
        Palette: deep neutral (not pure black), warm-leaning grey-blue surfaces,
        accent family shifted lighter for contrast on dark backgrounds.
        Inspiration: GitHub dark.
    -->

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="Brush.Surface.Shell"     Color="#0D1117" />
    <SolidColorBrush x:Key="Brush.Surface.Sidebar"   Color="#161B22" />
    <SolidColorBrush x:Key="Brush.Surface.Content"   Color="#161B22" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay"   Color="#21262D" />

    <!-- ===== Content (text / icons) ===== -->
    <SolidColorBrush x:Key="Brush.Content.Primary"   Color="#E6EDF3" />
    <SolidColorBrush x:Key="Brush.Content.Secondary" Color="#8B949E" />
    <SolidColorBrush x:Key="Brush.Content.Disabled"  Color="#484F58" />
    <SolidColorBrush x:Key="Brush.Content.OnAccent"  Color="#FFFFFF" />

    <!-- ===== Accent (interactive elements) ===== -->
    <SolidColorBrush x:Key="Brush.Accent.Default"    Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.Accent.Hover"      Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed"    Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Accent.Disabled"   Color="#1E40AF" />

    <!-- ===== Borders / separators ===== -->
    <SolidColorBrush x:Key="Brush.Border.Subtle"     Color="#21262D" />
    <SolidColorBrush x:Key="Brush.Border.Default"    Color="#30363D" />
    <SolidColorBrush x:Key="Brush.Border.Strong"     Color="#484F58" />

    <!-- ===== Interaction states ===== -->
    <SolidColorBrush x:Key="Brush.State.Hover"       Color="#21262D" />
    <SolidColorBrush x:Key="Brush.State.Pressed"     Color="#30363D" />
    <SolidColorBrush x:Key="Brush.State.Selected"    Color="#1E3A5F" />
    <SolidColorBrush x:Key="Brush.State.Focus"       Color="#60A5FA" />

    <!-- ===== Status ===== -->
    <SolidColorBrush x:Key="Brush.Status.Error"      Color="#F87171" />
    <SolidColorBrush x:Key="Brush.Status.Warning"    Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.Status.Success"    Color="#4ADE80" />
    <SolidColorBrush x:Key="Brush.Status.Info"       Color="#60A5FA" />

    <!-- ===== Toast surfaces ===== -->
    <SolidColorBrush x:Key="Brush.Toast.Background"     Color="#21262D" />
    <SolidColorBrush x:Key="Brush.Toast.Border"         Color="#30363D" />
    <SolidColorBrush x:Key="Brush.Toast.Shadow"         Color="#80000000" />

    <!-- ===== Special ===== -->
    <SolidColorBrush x:Key="Brush.Scrim"             Color="#A0000000" />

</ResourceDictionary>