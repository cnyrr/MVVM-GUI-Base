<UserControl x:Class="Wpf.Shell.Views.Monitor.MonitorDockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wpf.Shell.ViewModels.Monitor"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorShellViewModel}"
             Background="{DynamicResource Brush.Surface.Sidebar}">

    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
        <DockPanel LastChildFill="False">

            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding DisplayLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Body}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <!-- Mode buttons -->
            <Button DockPanel.Dock="Left" Content="Logo"
                    Command="{Binding SetLogoCommand}"
                    Margin="0,0,4,0" Padding="12,6"
                    Background="{Binding IsLogoActive, Converter={StaticResource ModeBrush}}" />

            <Button DockPanel.Dock="Left" Content="Mirror"
                    Command="{Binding SetMirrorCommand}"
                    Margin="0,0,4,0" Padding="12,6"
                    Background="{Binding IsMirrorActive, Converter={StaticResource ModeBrush}}" />

            <Button DockPanel.Dock="Left" Content="Enrich"
                    Command="{Binding SetEnrichCommand}"
                    IsEnabled="{Binding CanEnrich}"
                    Margin="0,0,16,0" Padding="12,6"
                    Background="{Binding IsEnrichActive, Converter={StaticResource ModeBrush}}" />

            <!-- Lock toggle -->
            <ToggleButton DockPanel.Dock="Left"
              IsChecked="{Binding IsInputLocked}"
              Padding="12,6" Margin="0,0,16,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="🔓 Unlocked" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Content.Primary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInputLocked}" Value="True">
                                <Setter Property="Content" Value="🔒 Locked" />
                                <Setter Property="Background" Value="{DynamicResource Brush.State.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- Dynamic snippet selector — present only on IMonitorAware screens -->
            <ItemsControl DockPanel.Dock="Left"
                          ItemsSource="{Binding DockSnippets}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DockLabel}"
                                Command="{Binding DataContext.SelectSnippetCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}"
                                Margin="0,0,4,0" Padding="10,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </DockPanel>
    </Border>
</UserControl>