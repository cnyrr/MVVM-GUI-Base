<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MVVM_Base.ViewModels"
                    xmlns:tvm="clr-namespace:MVVM_Base.ViewModels.Test"
                    xmlns:views="clr-namespace:MVVM_Base.Views"
                    xmlns:tviews="clr-namespace:MVVM_Base.Views.Test"
                    xmlns:vmToasts="clr-namespace:MVVM_Base.Services.Toasts.Internal"
                    xmlns:viewsToasts="clr-namespace:MVVM_Base.Views.Toasts">

    <!--
        VM → View mapping. WPF's ContentControl uses these implicit DataTemplates
        to resolve a View whenever a ViewModel is set as Content. The DataType
        match is by exact runtime type.

        Add one DataTemplate per (root or detail) ViewModel as the app grows.
    -->
    
    <DataTemplate DataType="{x:Type tvm:TestRootViewModel}">
        <tviews:TestRootView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tvm:Test1ViewModel}">
        <tviews:Test1View />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tvm:Test2ViewModel}">
        <tviews:Test2View />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmToasts:ToastViewModel}">
        <viewsToasts:ToastView />
    </DataTemplate>

</ResourceDictionary>