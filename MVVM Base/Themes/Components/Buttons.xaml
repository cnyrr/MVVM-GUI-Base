<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Component styles for the shell. Reference theme tokens (Brush.*) and
        sizing tokens (Space.*, Size.*, Thickness.*, Radius.*) via DynamicResource
        so theme swaps and any future sizing-token swap repaint without rebuilding.

        Two styles in this file:
          * Style.Button.Hamburger  — the always-visible menu button.
          * Style.Button.SidebarTab — sidebar row buttons. Selected-state styling
                                      is added per-instance via DataTrigger in
                                      ShellView.xaml.

        New shell-related button styles go here. Non-shell button styles
        (primary, secondary, danger, etc. for dialogs/forms) belong in their own
        component file when they arrive.
    -->

    <!-- ============================================================
         Style.Button.Hamburger
         ============================================================ -->
    <Style x:Key="Style.Button.Hamburger" TargetType="Button">
        <Setter Property="Width"  Value="{DynamicResource Size.Hamburger.Hit}" />
        <Setter Property="Height" Value="{DynamicResource Size.Hamburger.Hit}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Content.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Hit / fill layer -->
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.S}" />

                        <!-- Three-line icon -->
                        <Path x:Name="Icon"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="{DynamicResource Stroke.Strong}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 4,7 H 20 M 4,12 H 20 M 4,17 H 20"
                              Width="{DynamicResource Size.Hamburger.Icon}"
                              Height="{DynamicResource Size.Hamburger.Icon}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform" />

                        <!-- Outer focus ring. Shown only on keyboard focus. -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.State.Focus}"
                                BorderThickness="{DynamicResource Thickness.Stroke.Strong}"
                                CornerRadius="{DynamicResource Radius.S}"
                                Margin="-2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Style.Button.SidebarTab

         Full-width sidebar row. Left-aligned content. Hover / pressed /
         focus states only. Selected-state styling is the responsibility
         of the consumer — add via DataTrigger on the per-instance style.
         ============================================================ -->
    <Style x:Key="Style.Button.SidebarTab" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Height" Value="{DynamicResource Size.Touch.Default}" />
        <Setter Property="Padding">
            <Setter.Value>
                <Thickness Left="16" Top="8" Right="16" Bottom="8" />
            </Setter.Value>
        </Setter>
        <Setter Property="Margin">
            <Setter.Value>
                <Thickness Left="0" Top="0" Right="0" Bottom="2" />
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Content.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Default}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Fill layer. Background flips on hover / pressed and is
                             also the surface a consumer's selected-state DataTrigger
                             paints. -->
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.S}" />

                        <!-- Content (the consumer's <TextBlock/> etc.) -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <!-- Outer focus ring. -->
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Brush.State.Focus}"
                                BorderThickness="{DynamicResource Thickness.Stroke.Strong}"
                                CornerRadius="{DynamicResource Radius.S}"
                                Margin="-2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>