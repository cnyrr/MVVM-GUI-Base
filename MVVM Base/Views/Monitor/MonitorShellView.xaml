<UserControl x:Class="MVVM_Base.Views.Monitor.MonitorShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MVVM_Base.ViewModels.Monitor"
             xmlns:monitor_v="clr-namespace:MVVM_Base.Views.Monitor"
             xmlns:toasts="clr-namespace:MVVM_Base.Views.Toasts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorShellViewModel}"
             Background="{DynamicResource Brush.Surface.Shell}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- Dock: fixed chrome, always interactive, sits above the content region. -->
        <monitor_v:MonitorDockView DockPanel.Dock="Top" />

        <!-- Content region: hit-locked as a single unit. When ContentInteractive is false
         (display input-locked), the entire subtree — rendered surface AND toast layer —
         stops accepting input. The dock above is a sibling and is unaffected. -->
        <Grid IsHitTestVisible="{Binding ContentInteractive}">

            <!-- Layer 0: rendered surface. Null in Logo → dark background shows through. -->
            <ContentControl Content="{Binding Content}"
                        Focusable="False"
                        IsTabStop="False" />

            <!-- Layer 1: toast layer. DataContext fix (the shared host) is point B — left as-is
             for now; this step (C) only establishes the hit-lock structure. Visibility binds
             back to the shell's ToastsVisible via RelativeSource because this element's own
             DataContext will become the toast host in B. -->
            <toasts:ToastHostView
            Visibility="{Binding ToastsVisible,
                         Converter={StaticResource BoolToVis}}" />

        </Grid>
    </DockPanel>
</UserControl>