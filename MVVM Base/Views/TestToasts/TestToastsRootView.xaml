<UserControl x:Class="MVVM_Base.Views.TestToasts.TestToastsRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MVVM_Base.ViewModels.TestToasts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TestToastsRootViewModel}"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{DynamicResource Brush.Surface.Content}">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="{DynamicResource Width.Content.Narrow}">

            <TextBlock Text="Toast Test"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Display}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <TextBlock HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.BodyLarge}"
                       Foreground="{DynamicResource Brush.Content.Secondary}"
                       Text="Toasts appear in the bottom-right. Cap is 3 visible; further arrivals queue. Hover the toast region to pause; mouse leave resumes." />

            <!-- Severity row -->
            <TextBlock Text="Severities"
                       Margin="0,32,0,8"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <WrapPanel HorizontalAlignment="Left">
                <Button Command="{Binding ShowInfoCommand}"    Content="Info"    Padding="16,8" Margin="0,0,8,8" />
                <Button Command="{Binding ShowSuccessCommand}" Content="Success" Padding="16,8" Margin="0,0,8,8" />
                <Button Command="{Binding ShowWarningCommand}" Content="Warning" Padding="16,8" Margin="0,0,8,8" />
                <Button Command="{Binding ShowErrorCommand}"   Content="Error (sticky)" Padding="16,8" Margin="0,0,8,8" />
            </WrapPanel>

            <!-- Duration row -->
            <TextBlock Text="Durations"
                       Margin="0,24,0,8"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <WrapPanel HorizontalAlignment="Left">
                <Button Command="{Binding ShowShortCommand}" Content="Short (~2s)"   Padding="16,8" Margin="0,0,8,8" />
                <Button Command="{Binding ShowLongCommand}"  Content="Long  (~6s)"   Padding="16,8" Margin="0,0,8,8" />
            </WrapPanel>

            <!-- Batch row -->
            <TextBlock Text="Batch"
                       Margin="0,24,0,8"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox Text="{Binding FireCount, UpdateSourceTrigger=PropertyChanged}"
                         Width="60"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         FontFamily="{DynamicResource FontFamily.Default}"
                         FontSize="{DynamicResource FontSize.Body}" />
                <Button Command="{Binding FireBatchCommand}"
                        Content="Fire N info toasts"
                        Padding="16,8"
                        Margin="8,0,0,0" />
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>