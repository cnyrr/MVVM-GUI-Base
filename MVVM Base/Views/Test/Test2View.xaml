<UserControl x:Class="MVVM_Base.Views.Test.Test2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.microsoft.com/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MVVM_Base.ViewModels.Test"
             Background="{DynamicResource Brush.Surface.Content}">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="{DynamicResource Width.Content.Narrow}">

            <TextBlock Text="Test 2"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Display}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <CheckBox Content="Allow leaving this view"
                      IsChecked="{Binding AllowLeaving}"
                      HorizontalAlignment="Center"
                      Margin="0,32,0,0"
                      FontFamily="{DynamicResource FontFamily.Default}"
                      FontSize="{DynamicResource FontSize.BodyLarge}"
                      Foreground="{DynamicResource Brush.Content.Primary}" />

            <TextBlock HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource Brush.Content.Secondary}"
                       Text="When unchecked, the navigation guard blocks any attempt to leave (back, forward, or tab switch). The Back button below will appear to do nothing." />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,0">
                <Button Command="{Binding GoBackCommand}"
                        Content="Back"
                        Padding="16,8" />
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>