<UserControl x:Class="MVVM_Base.Views.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MVVM_Base.ViewModels.Shell"
             xmlns:shell_v="clr-namespace:MVVM_Base.Views.Shell"
             xmlns:toasts="clr-namespace:MVVM_Base.Views.Toasts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{DynamicResource Brush.Surface.Shell}"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!--
        Layered Grid. All children share the same cell; z-order = declaration order.
        Per-design: hamburger sits ABOVE the sidebar (always visible, always clickable).

          Layer 0: Content           (active tab's CurrentViewModel)
          Layer 1: Scrim             (visible only while sidebar expanded; click-to-close)
          Layer 2: Sidebar           (SidebarView; owns its own styled root)
          Layer 3: Hamburger button  (always visible, always clickable, top-left)
          Layer 4: Toast host        (top-most; hit-tests only where toasts paint)
    -->
    <Grid>

        <!-- ===== Layer 0: Main content ===== -->
        <ContentControl Content="{Binding CurrentViewModel}"
                        Background="{DynamicResource Brush.Surface.Content}"
                        Focusable="False"
                        IsTabStop="False" />

        <!-- ===== Layer 1: Scrim ===== -->
        <Border x:Name="Scrim"
                Background="{DynamicResource Brush.Scrim}"
                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding ToggleSidebarCommand}" />
            </Border.InputBindings>
        </Border>

        <!-- ===== Layer 2: Sidebar ===== -->
        <shell_v:SidebarView DataContext="{Binding Sidebar}"
                             Visibility="{Binding DataContext.IsSidebarExpanded,
                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Converter={StaticResource BoolToVis}}" />

        <!-- ===== Layer 3: Hamburger button (always visible, always on top) ===== -->
        <Button Style="{StaticResource Style.Button.Hamburger}"
                Command="{Binding ToggleSidebarCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                ToolTip="Menu"
                AutomationProperties.Name="Menu" />

        <!-- ===== Layer 4: Toast host ===== -->
        <toasts:ToastHostView DataContext="{StaticResource SharedToastHost}" />

    </Grid>
</UserControl>
