<UserControl x:Class="MVVM_Base.Views.TestMonitor.TestMonitorRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MVVM_Base.ViewModels.TestMonitor"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TestMonitorRootViewModel}"
             Background="{DynamicResource Brush.Surface.Content}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="{DynamicResource Width.Content.Narrow}">
        <TextBlock Text="Monitor Tests"
                   HorizontalAlignment="Center"
                   FontFamily="{DynamicResource FontFamily.Default}"
                   FontSize="{DynamicResource FontSize.Display}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Content.Primary}" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,16,0,0"
                   FontFamily="{DynamicResource FontFamily.Default}"
                   FontSize="{DynamicResource FontSize.BodyLarge}"
                   Foreground="{DynamicResource Brush.Content.Secondary}"
                   Text="This tab offers three snippets to secondary displays. Set a monitor to Enrich and pick snippets from its dock. The Polling snippet runs only while visible — switch away and watch it freeze, switch back and watch it resume from the preserved count." />
    </StackPanel>
</UserControl>