<UserControl x:Class="MVVM_Base.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MVVM_Base.ViewModels"
             xmlns:nav="clr-namespace:MVVM_Base.Services.Navigation.Contracts"
             xmlns:toasts="clr-namespace:MVVM_Base.Views.Toasts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{DynamicResource Brush.Surface.Shell}"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!--
        Layered Grid. All children share the same cell; z-order = declaration order.
        Per-design: hamburger sits ABOVE the sidebar (always visible, always clickable).

          Layer 0: Content           (active tab's CurrentViewModel)
          Layer 1: Scrim             (visible only while sidebar expanded; click-to-close)
          Layer 2: Sidebar panel     (overlay; does not reflow content)
          Layer 3: Hamburger button  (always visible, always clickable, top-left)
    -->
    <Grid>

        <!-- ===== Layer 0: Main content ===== -->
        <ContentControl Content="{Binding CurrentViewModel}"
                        Background="{DynamicResource Brush.Surface.Content}"
                        Focusable="False"
                        IsTabStop="False" />

        <!-- ===== Layer 1: Scrim ===== -->
        <Border x:Name="Scrim"
                Background="{DynamicResource Brush.Scrim}"
                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding ToggleSidebarCommand}" />
            </Border.InputBindings>
        </Border>

        <!-- ===== Layer 2: Sidebar panel ===== -->
        <Border x:Name="SidebarPanel"
                HorizontalAlignment="Left"
                Width="{DynamicResource Size.Sidebar.Width}"
                Background="{DynamicResource Brush.Surface.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"
                KeyboardNavigation.TabNavigation="Cycle"
                FocusManager.IsFocusScope="True">

            <DockPanel LastChildFill="True">

                <!-- Header. Reserves the corner the hamburger occupies. -->
                <Border DockPanel.Dock="Top"
                        Height="{DynamicResource Size.Sidebar.HeaderHeight}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="MVVM Base"
                               VerticalAlignment="Center"
                               Margin="64,0,16,0"
                               FontFamily="{DynamicResource FontFamily.Default}"
                               FontSize="{DynamicResource FontSize.BodyLarge}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Content.Primary}" />
                </Border>

                <!-- Tab list. Hardcoded for now; data-driven later (login + roles). -->
                <StackPanel Orientation="Vertical"
                            Margin="8">

                    <Button Command="{Binding SwitchTabCommand}"
                            CommandParameter="{x:Static nav:TabKey.Test}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource Style.Button.SidebarTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}"
                                                 Value="{x:Static nav:TabKey.Test}">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Brush.State.Selected}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Brush.Accent.Default}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Test" />
                    </Button>
                    
                    <Button Command="{Binding SwitchTabCommand}"
                            CommandParameter="{x:Static nav:TabKey.TestToasts}">
                        <Button.Style>
                            <Style TargetType="Button"
                                    BasedOn="{StaticResource Style.Button.SidebarTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}"
                                                Value="{x:Static nav:TabKey.TestToasts}">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Brush.State.Selected}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Brush.Accent.Default}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Toast Test" />
                    </Button>

                    <!-- Additional tab buttons here as TabKey grows. Each repeats the
                         per-instance style with its own DataTrigger Value. -->

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===== Layer 3: Hamburger button (always visible, always on top) ===== -->
        <Button Style="{StaticResource Style.Button.Hamburger}"
                Command="{Binding ToggleSidebarCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                ToolTip="Menu"
                AutomationProperties.Name="Menu" />

        <!-- Layer 4: Toast host. Top-most. Hit-tests only where toasts paint. -->
        <toasts:ToastHostView DataContext="{Binding ToastHost}" />

    </Grid>
</UserControl>