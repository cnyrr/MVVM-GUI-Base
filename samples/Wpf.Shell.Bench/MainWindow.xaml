<Window x:Class="Wpf.Shell.Bench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wpf.Shell.Views.Shell;assembly=Wpf.Shell"
        mc:Ignorable="d"
        Title="Wpf.Shell.Bench"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="{DynamicResource Brush.Surface.Shell}"
        FontFamily="{DynamicResource FontFamily.Default}"
        FontSize="{DynamicResource FontSize.Body}"
        Foreground="{DynamicResource Brush.Content.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        >
    <views:ShellView />
</Window>
