<Application x:Class="Wpf.Shell.Bench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wpf.Shell.Bench"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--
                    Merge order matters.

                    1. Framework entry dictionary — sizing, tokens, component
                       styles, and framework VM ↔ View mappings. Must be first
                       so app-level keys below can override framework defaults.
                    2. Bench's own VM ↔ View mappings.

                    The active theme dictionary is appended at runtime by
                    ITheming, landing after both and overriding token values.
                -->
                <ResourceDictionary Source="pack://application:,,,/Wpf.Shell;component/Wpf.Shell.xaml" />
                <ResourceDictionary Source="Resources/DataTemplates.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>