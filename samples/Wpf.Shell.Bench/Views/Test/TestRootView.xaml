<UserControl x:Class="Wpf.Shell.Bench.Views.Test.TestRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Wpf.Shell.Bench.ViewModels.Test"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TestRootViewModel}"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{DynamicResource Brush.Surface.Content}">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="{DynamicResource Width.Content.Narrow}">

            <TextBlock Text="Test"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.Display}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Content.Primary}" />

            <TextBlock Text="{Binding Message}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontFamily="{DynamicResource FontFamily.Default}"
                       FontSize="{DynamicResource FontSize.BodyLarge}"
                       Foreground="{DynamicResource Brush.Content.Secondary}" />
            
            <Button Command="{Binding GoForwardToTest1Command}"
                    Content="Forward to Test 1"
                    HorizontalAlignment="Center"
                    Padding="16,8"
                    Margin="0,32,0,0" />
            

        </StackPanel>
    </Grid>
</UserControl>